[
  {
    "name": "theme_info",
    "theme_name": "AKYRO MONOLITH OS",
    "theme_version": "0.9.0",
    "theme_author": "Ahmed Fouad",
    "theme_documentation_url": "https://example.com/docs",
    "theme_support_url": "https://example.com/support"
  },
  {
    "name": "Brand assets — locked",
    "settings": [
      {
        "type": "paragraph",
        "content": "Use locked AKYRO production exports only. Do not upload alternate, recolored, stretched, or reinterpreted marks."
      },
      {
        "type": "image_picker",
        "id": "logo_wordmark",
        "label": "Locked AKYRO wordmark"
      },
      {
        "type": "image_picker",
        "id": "logo_a_mark",
        "label": "Locked iconic A mark"
      },
      {
        "type": "image_picker",
        "id": "logo_red_dash",
        "label": "Locked red dash asset"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "range",
        "id": "logo_wordmark_width",
        "label": "Wordmark width",
        "min": 100,
        "max": 220,
        "step": 2,
        "unit": "px",
        "default": 146
      }
    ]
  },
  {
    "name": "Palette — system",
    "settings": [
      {
        "type": "paragraph",
        "content": "Signal red is functional only. Do not use as a decorative background."
      },
      {
        "type": "color",
        "id": "akyro_black",
        "label": "Black",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "akyro_charcoal",
        "label": "Charcoal",
        "default": "#1A1A1C"
      },
      {
        "type": "color",
        "id": "akyro_warm_grey",
        "label": "Warm grey",
        "default": "#D9D9D9"
      },
      {
        "type": "color",
        "id": "akyro_white",
        "label": "Off white",
        "default": "#F2F2F2"
      },
      {
        "type": "color",
        "id": "akyro_red",
        "label": "Signal red",
        "default": "#E30613"
      }
    ]
  },
  {
    "name": "Theme mode",
    "settings": [
      {
        "type": "select",
        "id": "theme_mode",
        "label": "Mode",
        "default": "dark",
        "options": [
          {
            "value": "dark",
            "label": "Dark — MONOLITH OS"
          },
          {
            "value": "light",
            "label": "Light — concrete"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": "Both modes support EN LTR and AR RTL. Signal red stays functional only."
      }
    ]
  },
  {
    "name": "Design controls",
    "settings": [
      {
        "type": "range",
        "id": "page_max",
        "label": "Container width",
        "min": 1200,
        "max": 1680,
        "step": 40,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "base_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 8,
        "step": 1,
        "unit": "px",
        "default": 0,
        "info": "AKYRO system = 0. Exposed for resale flexibility."
      },
      {
        "type": "range",
        "id": "motion_speed",
        "label": "Animation speed",
        "min": 120,
        "max": 320,
        "step": 20,
        "unit": "ms",
        "default": 180
      },
      {
        "type": "select",
        "id": "section_gap_scale",
        "label": "Section spacing scale",
        "default": "default",
        "options": [
          {
            "value": "compact",
            "label": "Compact"
          },
          {
            "value": "default",
            "label": "Default"
          },
          {
            "value": "spacious",
            "label": "Spacious"
          }
        ]
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Font stacks only — no bundled files. TODO: self-host licensed woff2 (EN: Inter; AR: Alexandria headings / Cairo body) and update base.css @font-face."
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main menu"
      },
      {
        "type": "checkbox",
        "id": "enable_locale_switcher_header",
        "label": "Show locale switcher in header",
        "default": true
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_footer_access",
        "label": "Show footer access form",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_footer_locale_switcher",
        "label": "Show locale switcher in footer",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_restricted_tagline",
        "label": "Show restricted tagline",
        "default": false
      },
      {
        "type": "paragraph",
        "content": "Restricted AKYRO phrases must not be used casually. Keep this off unless approved."
      }
    ]
  },
  {
    "name": "Product system",
    "settings": [
      {
        "type": "paragraph",
        "content": "Product proof blocks must render from approved inputs only. Do not invent measurements, validation results, stock claims, or batch data."
      },
      {
        "type": "text",
        "id": "metafield_namespace",
        "label": "Product metafield namespace",
        "default": "akyro"
      }
    ]
  }
]