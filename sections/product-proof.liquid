{%- comment -%}
  AKYRO — sections/product-proof.liquid (M01-D)
  FIT / FABRIC / CONSTRUCTION triptych. Merchant-editable lines only;
  no invented measurements, validation, stock or QC claims.
{%- endcomment -%}

{{ 'section-product-proof.css' | asset_url | stylesheet_tag }}

<section class="product-proof section" data-section-id="{{ section.id }}">
  <div class="frame">
    <div class="product-proof__head">
      <p class="label">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="grid grid--proof product-proof__grid">
      {%- for block in section.blocks -%}
        <article class="product-proof__card" {{ block.shopify_attributes }}>
          <div class="product-proof__index data-latin">{{ forloop.index | prepend: '0' }}</div>
          {% render 'media', image: block.settings.image, class: 'product-proof__media', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: block.settings.label %}
          <div class="product-proof__body flow-tight">
            <h3 class="label">{{ block.settings.label }}</h3>
            <p>{{ block.settings.line }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product proof",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PRODUCT PROOF"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Fit, fabric and construction before launch."}
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Proof item",
      "settings": [
        {"type": "text", "id": "label", "label": "Label", "default": "FIT"},
        {"type": "textarea", "id": "line", "label": "Proof line", "default": "Replace with approved product-level proof before launch."},
        {"type": "image_picker", "id": "image", "label": "Image"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Product proof",
      "blocks": [
        {"type": "proof", "settings": {"label": "FIT", "line": "Approved fit notes land here after sample review."}},
        {"type": "proof", "settings": {"label": "FABRIC", "line": "Material details render only from approved product decisions."}},
        {"type": "proof", "settings": {"label": "CONSTRUCTION", "line": "Construction language stays tied to real product files."}}
      ]
    }
  ]
}
{% endschema %}
