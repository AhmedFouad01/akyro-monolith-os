{%- comment -%}
  AKYRO — sections/hero-monolith.liquid (M02-A)
  One product, one statement, one CTA. No carousel.
  Demo media is editable from Theme Editor and can be replaced by image_picker.
{%- endcomment -%}

{{ 'section-hero-monolith.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_product = section.settings.product
  assign hero_image = section.settings.image
  assign hero_asset = blank

  if hero_image == blank and hero_product != blank
    assign hero_image = hero_product.featured_image
  endif

  case section.settings.demo_media
    when 'tee_front'
      assign hero_asset = 'akyro-demo-hero-tee.png'
    when 'tee_back'
      assign hero_asset = 'akyro-demo-tee-back.png'
    when 'fabric'
      assign hero_asset = 'akyro-demo-fabric-detail.png'
    when 'construction'
      assign hero_asset = 'akyro-demo-construction-detail.png'
    when 'objects'
      assign hero_asset = 'akyro-demo-objects-index.png'
    when 'scent'
      assign hero_asset = 'akyro-demo-scent-index.png'
  endcase

  if hero_image != blank
    assign hero_asset = blank
  endif
-%}

<section class="hero-monolith section section--flush" data-section-id="{{ section.id }}">
  <div class="frame hero-monolith__grid">
    <div class="hero-monolith__copy flow">
      <div class="hero-monolith__eyebrow label">
        {% render 'red-dash' %}
        <span>{{ section.settings.eyebrow }}</span>
      </div>

      <h1 class="hero-monolith__title">{{ section.settings.heading }}</h1>
      <p class="hero-monolith__text">{{ section.settings.body }}</p>

      <div class="hero-monolith__actions">
        {%- if hero_product != blank -%}
          <a href="{{ hero_product.url }}" class="btn">{{ 'home.hero.view_product_file' | t }}</a>
          {% render 'badge-status', product: hero_product %}
        {%- else -%}
          <span class="text-data">{{ 'home.hero.no_product' | t }}</span>
        {%- endif -%}
      </div>
    </div>

    <div class="hero-monolith__visual">
      {%- if hero_product != blank -%}<a href="{{ hero_product.url }}" aria-label="{{ hero_product.title | escape }}">{%- endif -%}
        {% render 'media',
          image: hero_image,
          asset: hero_asset,
          class: 'hero-monolith__media',
          sizes: '(min-width: 990px) 56vw, 100vw',
          loading: 'eager',
          alt: section.settings.media_alt
        %}
      {% render 'image-guide', image: section.settings.image, rw: 4, rh: 5, min_w: 1500 %}
      {%- if hero_product != blank -%}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero monolith",
  "settings": [
    {"type": "product", "id": "product", "label": "Hero product"},
    {"type": "image_picker", "id": "image", "label": "Production image override", "info": "2400×3000 px · 4:5 · JPEG ≤ 700 KB"},
    {
      "type": "select",
      "id": "demo_media",
      "label": "Demo media asset",
      "default": "tee_front",
      "options": [
        {"value": "none", "label": "None"},
        {"value": "tee_front", "label": "Demo — black tee front"},
        {"value": "tee_back", "label": "Demo — black tee back"},
        {"value": "fabric", "label": "Demo — fabric detail"},
        {"value": "construction", "label": "Demo — construction detail"},
        {"value": "objects", "label": "Demo — objects"},
        {"value": "scent", "label": "Demo — scent"}
      ]
    },
    {"type": "text", "id": "media_alt", "label": "Media alt text", "default": "AKYRO demo garment image"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PRODUCT-LED SYSTEM"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Designed from product proof, not decoration."},
    {"type": "textarea", "id": "body", "label": "Body", "default": "AKYRO releases are built around fit, material, construction and controlled drop logic. The first product file appears when approved data lands."}
  ],
  "presets": [{"name": "Hero monolith"}]
}
{% endschema %}
