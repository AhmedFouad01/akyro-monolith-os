{%- comment -%}
  AKYRO — sections/editable-block-grid.liquid (M02-D)
  The Theme Editor CMS grid. Block types: text, media, text_media,
  cta, proof, stat, link_card. Sizes map to the 6-col grid-system.
  Grid-disciplined: no masonry, no text-over-image by default
  (optional overlay uses the scrim token and stays readable).
{%- endcomment -%}

{{ 'section-editable-block-grid.css' | asset_url | stylesheet_tag }}

<div class="section-shell {% render 'section-style', s: section.settings %} block-grid">
  <div class="frame">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="shell-head">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid-system">
      {%- for block in section.blocks -%}
        {%- liquid
          assign size = block.settings.size | default: 'third'
          assign al = block.settings.align | default: 'start'
          assign bg = block.settings.bg_mode | default: 'default'
          assign demo_asset = blank
          case block.settings.demo_media
            when 'fashion'
              assign demo_asset = 'akyro-demo-fashion-index.png'
            when 'objects'
              assign demo_asset = 'akyro-demo-objects-index.png'
            when 'scent'
              assign demo_asset = 'akyro-demo-scent-index.png'
            when 'tee_front'
              assign demo_asset = 'akyro-demo-hero-tee.png'
            when 'tee_back'
              assign demo_asset = 'akyro-demo-tee-back.png'
            when 'fabric'
              assign demo_asset = 'akyro-demo-fabric-detail.png'
            when 'construction'
              assign demo_asset = 'akyro-demo-construction-detail.png'
          endcase
          if block.settings.image != blank
            assign demo_asset = blank
          endif
          assign has_media = false
          if block.settings.image != blank or demo_asset != blank
            assign has_media = true
          endif
        -%}

        <div
          class="block block--{{ block.type | replace: '_', '-' }} block--{{ size }} block--align-{{ al }}{% if bg != 'default' %} block--bg-{{ bg }}{% endif %}{% if block.settings.overlay and has_media %} block--overlay{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if has_media and block.type != 'text' and block.type != 'cta' and block.type != 'stat' -%}
            <div class="block__media{% if size == '3x2' %} block__media--3x2{% endif %}{% if size == 'square' %} block__media--square{% endif %}">
              {% render 'media',
                image: block.settings.image,
                asset: demo_asset,
                class: 'block__img',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                alt: block.settings.media_alt
              %}
            </div>
          {%- endif -%}

          {%- if block.type != 'media' -%}
            <div class="block__body">
              {%- if block.settings.num != blank -%}<span class="block__num data-latin">{{ block.settings.num }}</span>{%- endif -%}
              {%- if block.settings.eyebrow != blank -%}<span class="label">{{ block.settings.eyebrow }}</span>{%- endif -%}
              {%- if block.type == 'stat' and block.settings.stat_value != blank -%}
                <span class="stat-value data-latin">{{ block.settings.stat_value }}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
              {%- if block.settings.body != blank -%}<p{% if block.type == 'proof' %} class="text-data"{% endif %}>{{ block.settings.body }}</p>{%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <span class="block__cta">
                  <a href="{{ block.settings.button_link | default: '#' }}" class="btn{% if block.type == 'cta' %} btn--primary{% endif %}">{{ block.settings.button_label }}</a>
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if block.type == 'link_card' and block.settings.button_link != blank -%}
            <a href="{{ block.settings.button_link }}" class="block__link-cover" aria-label="{{ block.settings.heading | default: block.settings.button_label | escape }}"></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

