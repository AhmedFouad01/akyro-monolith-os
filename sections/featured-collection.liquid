{%- comment -%}
  AKYRO — sections/featured-collection.liquid (M02-D)
  Editor-picked collection strip. Real products only; controlled
  empty state when nothing is selected.
{%- endcomment -%}

{{ 'section-featured.css' | asset_url | stylesheet_tag }}

{%- assign col = section.settings.collection -%}

<div class="section-shell {% render 'section-style', s: section.settings %} featured-collection">
  <div class="frame">
    <div class="shell-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p class="featured__body">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    {%- if col != blank and col.products_count > 0 -%}
      <div
        class="cards-grid"
        style="--cols-m: {{ section.settings.cols_mobile }}; --cols-d: {{ section.settings.cols_desktop }};"
      >
        {%- for product in col.products limit: section.settings.limit -%}
          {% render 'product-card',
            product: product,
            ratio: section.settings.card_ratio,
            show_price: section.settings.show_price,
            show_status: section.settings.show_status,
            show_sku: section.settings.show_sku
          %}
        {%- endfor -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <div class="featured__cta">
          <a href="{{ section.settings.button_link | default: col.url }}" class="btn">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state flow">
        <p>{{ 'sections.featured.empty_collection' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {"type": "header", "content": "Content"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Featured stream"},
    {"type": "textarea", "id": "body", "label": "Body"},
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "range", "id": "limit", "label": "Product limit", "min": 2, "max": 12, "step": 1, "default": 4},
    {"type": "text", "id": "button_label", "label": "Button label"},
    {"type": "url", "id": "button_link", "label": "Button link (blank = collection)"},
    {"type": "header", "content": "Grid"},
    {"type": "select", "id": "cols_desktop", "label": "Columns — desktop", "default": "4",
     "options": [{"value": "2", "label": "2"}, {"value": "3", "label": "3"}, {"value": "4", "label": "4"}]},
    {"type": "select", "id": "cols_mobile", "label": "Columns — mobile", "default": "2",
     "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}]},
    {"type": "select", "id": "card_ratio", "label": "Image ratio", "default": "4x5",
     "options": [{"value": "4x5", "label": "4:5"}, {"value": "1x1", "label": "1:1"}, {"value": "16x9", "label": "16:9"}]},
    {"type": "checkbox", "id": "show_price", "label": "Show price", "default": true},
    {"type": "checkbox", "id": "show_status", "label": "Show status badge", "default": true},
    {"type": "checkbox", "id": "show_sku", "label": "Show style no (SKU)", "default": false},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "width", "label": "Section width", "default": "normal",
     "options": [{"value": "normal", "label": "Normal"}, {"value": "wide", "label": "Wide"}, {"value": "full", "label": "Full"}]},
    {"type": "select", "id": "spacing", "label": "Section spacing", "default": "default",
     "options": [{"value": "compact", "label": "Compact"}, {"value": "default", "label": "Default"}, {"value": "spacious", "label": "Spacious"}]},
    {"type": "select", "id": "bg_mode", "label": "Background", "default": "default",
     "options": [{"value": "default", "label": "Default"}, {"value": "surface", "label": "Surface"}, {"value": "raised", "label": "Raised"}, {"value": "inverse", "label": "Inverse"}]},
    {"type": "select", "id": "align", "label": "Text alignment", "default": "start",
     "options": [{"value": "start", "label": "Start"}, {"value": "center", "label": "Center"}]}
  ],
  "presets": [{"name": "Featured collection"}]
}
{% endschema %}
