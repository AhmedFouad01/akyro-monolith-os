{%- comment -%}
  AKYRO — sections/collection-index.liquid (M02-A)
  Fashion / Objects / Scent entries.
  Demo media is Theme Editor controlled and replaceable.
{%- endcomment -%}

{{ 'section-collection-index.css' | asset_url | stylesheet_tag }}

<section class="collection-index section line-block" data-section-id="{{ section.id }}">
  <div class="frame">
    <div class="collection-index__head">
      <p class="label">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="collection-index__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign demo_asset = blank

          case block.settings.demo_media
            when 'fashion'
              assign demo_asset = 'akyro-demo-fashion-index.png'
            when 'objects'
              assign demo_asset = 'akyro-demo-objects-index.png'
            when 'scent'
              assign demo_asset = 'akyro-demo-scent-index.png'
            when 'tee_front'
              assign demo_asset = 'akyro-demo-hero-tee.png'
            when 'tee_back'
              assign demo_asset = 'akyro-demo-tee-back.png'
          endcase

          if block.settings.image != blank
            assign demo_asset = blank
          endif
        -%}

        <a class="collection-index__item" href="{{ collection.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          {% render 'media',
            image: block.settings.image,
            asset: demo_asset,
            class: 'collection-index__media',
            sizes: '(min-width: 990px) 33vw, 100vw',
            loading: 'lazy',
            alt: block.settings.media_alt
          %}
          <div class="collection-index__body">
            <span class="data-latin">0{{ forloop.index }}</span>
            <h3>{{ block.settings.label }}</h3>
            <p>{{ block.settings.line }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection index",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "INDEX"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Streams built as repeatable systems."}
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Index entry",
      "settings": [
        {"type": "collection", "id": "collection", "label": "Collection"},
        {"type": "image_picker", "id": "image", "label": "Production image override"},
        {
          "type": "select",
          "id": "demo_media",
          "label": "Demo media asset",
          "default": "none",
          "options": [
            {"value": "none", "label": "None"},
            {"value": "fashion", "label": "Demo — fashion"},
            {"value": "objects", "label": "Demo — objects"},
            {"value": "scent", "label": "Demo — scent"},
            {"value": "tee_front", "label": "Demo — black tee front"},
            {"value": "tee_back", "label": "Demo — black tee back"}
          ]
        },
        {"type": "text", "id": "media_alt", "label": "Media alt text", "default": "AKYRO demo stream image"},
        {"type": "text", "id": "label", "label": "Label", "default": "FASHION"},
        {"type": "text", "id": "line", "label": "Line", "default": "Product-led releases."}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Collection index",
      "blocks": [
        {"type": "entry", "settings": {"label": "FASHION", "line": "Garments built through fit and construction.", "demo_media": "fashion", "media_alt": "AKYRO demo fashion stream image"}},
        {"type": "entry", "settings": {"label": "OBJECTS", "line": "Objects treated with the same material discipline.", "demo_media": "objects", "media_alt": "AKYRO demo objects stream image"}},
        {"type": "entry", "settings": {"label": "SCENT", "line": "Scent as another controlled product stream.", "demo_media": "scent", "media_alt": "AKYRO demo scent stream image"}}
      ]
    }
  ]
}
{% endschema %}
