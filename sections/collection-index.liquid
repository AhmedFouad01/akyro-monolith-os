{%- comment -%}
  AKYRO — sections/collection-index.liquid (M01-D)
  Fashion / Objects / Scent entries. No logo repeats.
{%- endcomment -%}

{{ 'section-collection-index.css' | asset_url | stylesheet_tag }}

<section class="collection-index section line-block" data-section-id="{{ section.id }}">
  <div class="frame">
    <div class="collection-index__head">
      <p class="label">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="collection-index__grid">
      {%- for block in section.blocks -%}
        {%- liquid assign collection = block.settings.collection -%}
        <a class="collection-index__item" href="{{ collection.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          {% render 'media', image: block.settings.image, class: 'collection-index__media', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: block.settings.label %}
          <div class="collection-index__body">
            <span class="data-latin">0{{ forloop.index }}</span>
            <h3>{{ block.settings.label }}</h3>
            <p>{{ block.settings.line }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection index",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "INDEX"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Streams built as repeatable systems."}
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Index entry",
      "settings": [
        {"type": "collection", "id": "collection", "label": "Collection"},
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "label", "label": "Label", "default": "FASHION"},
        {"type": "text", "id": "line", "label": "Line", "default": "Product-led releases."}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Collection index",
      "blocks": [
        {"type": "entry", "settings": {"label": "FASHION", "line": "Garments built through fit and construction."}},
        {"type": "entry", "settings": {"label": "OBJECTS", "line": "Objects treated with the same material discipline."}},
        {"type": "entry", "settings": {"label": "SCENT", "line": "Scent as another controlled product stream."}}
      ]
    }
  ]
}
{% endschema %}
