{%- comment -%}
  AKYRO — snippets/product-card.liquid (M01-D)
  Product card: image, name, style no, price, status. No quick add.
  Params: product
{%- endcomment -%}

{%- if product != blank -%}
  <article class="product-card">
    <a href="{{ product.url }}" class="product-card__media" aria-label="{{ product.title | escape }}">
      {% render 'media', image: product.featured_image, class: 'product-card__image', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: product.title %}
    </a>
    <div class="product-card__body">
      <div class="product-card__top">
        <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
        {% render 'badge-status', product: product %}
      </div>
      <div class="product-card__meta">
        {%- if product.metafields.akyro.batch.value.style_no != blank -%}
          <span class="data-latin">{{ product.metafields.akyro.batch.value.style_no }}</span>
        {%- elsif product.metafields.akyro.style_no != blank -%}
          <span class="data-latin">{{ product.metafields.akyro.style_no }}</span>
        {%- endif -%}
        {% render 'price', product: product %}
      </div>
    </div>
  </article>
{%- endif -%}
