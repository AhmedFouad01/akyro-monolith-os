{%- comment -%}
  AKYRO — snippets/logo-wordmark.liquid (M02-C)
  LOCKED wordmark from Theme settings → Brand assets. Never redrawn,
  recolored (no CSS filters), stretched, or mirrored in RTL.
  Fallback: shop name in display type until the locked asset lands.
  Width via settings.logo_wordmark_width; height resolves by ratio
  (object-fit: contain) — uploaded file is never distorted.
{%- endcomment -%}

{%- liquid
  assign w = settings.logo_wordmark_width | default: 146
  assign w2x = w | times: 2
-%}

{%- if settings.logo_wordmark != blank -%}
  <a href="{{ routes.root_url }}" class="logo-wordmark" aria-label="{{ shop.name | escape }}" data-home-link>
    <img
      src="{{ settings.logo_wordmark | image_url: width: w2x }}"
      alt="{{ shop.name | escape }}"
      class="logo-wordmark__img"
      style="--logo-w: {{ w }}px"
      width="{{ w }}"
      height="24"
      loading="eager"
    >
  </a>
{%- else -%}
  <a href="{{ routes.root_url }}" class="logo-wordmark logo-wordmark--text" data-home-link>{{ shop.name }}</a>
{%- endif -%}
