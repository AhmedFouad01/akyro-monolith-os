{%- comment -%}
  AKYRO — snippets/media.liquid (M01-D)
  Responsive image wrapper. No shimmer. Charcoal placeholder when absent.
  Params:
  - image
  - class
  - widths
  - sizes
  - loading
  - alt
{%- endcomment -%}

{%- liquid
  assign media_class = class | default: 'media'
  assign media_widths = widths | default: '360, 540, 720, 960, 1200, 1600'
  assign media_sizes = sizes | default: '100vw'
  assign media_loading = loading | default: 'lazy'
  assign media_alt = alt | default: image.alt | default: ''
-%}

<div class="{{ media_class }} media-shell{% if image == blank %} media-shell--empty{% endif %}">
  {%- if image != blank -%}
    {{ image
      | image_url: width: 1600
      | image_tag:
        widths: media_widths,
        sizes: media_sizes,
        loading: media_loading,
        alt: media_alt,
        class: 'media-shell__img'
    }}
  {%- endif -%}
</div>
